# Copier en scripts/install.env (ignoré par git) puis remplir. NE JAMAIS committer ce fichier rempli.

# Supabase → bouton « Connect » → Session pooler → URI (remplacer [YOUR-PASSWORD] par le mot de passe de la base)
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Identifiant du projet (dans l'URL du tableau de bord : supabase.com/dashboard/project/<ref>)
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# Jeton personnel pour déployer les Edge Functions : supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facultatif : clé Anthropic pour l'assistant IA (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
